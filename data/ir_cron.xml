<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Corre seguido a propósito (cada 10 min): cada corrida solo
             avanza el cursor de página dentro de un presupuesto de tiempo
             seguro (sync_from_freematica). La cadencia real de "cada
             cuánto se resincroniza todo el catálogo" la controla
             providers_sync_interval_hours / accounts_sync_interval_hours
             (freematica.config, default 24h) — no este intervalo. -->
        <record id="ir_cron_freematica_sync_providers" model="ir.cron">
            <field name="name">Freematica: Sincronizar proveedores</field>
            <field name="model_id" ref="model_freematica_config"/>
            <field name="state">code</field>
            <field name="code">model._cron_sync_providers()</field>
            <field name="interval_number" eval="10"/>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>

        <record id="ir_cron_freematica_sync_accounts" model="ir.cron">
            <field name="name">Freematica: Sincronizar plan de cuentas</field>
            <field name="model_id" ref="model_freematica_config"/>
            <field name="state">code</field>
            <field name="code">model._cron_sync_accounts()</field>
            <field name="interval_number" eval="10"/>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
