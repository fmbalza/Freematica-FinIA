<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Corre seguido a propósito (cada 10 min): cada corrida solo
             avanza el cursor de página dentro de un presupuesto de tiempo
             seguro (sync_from_freematica). La cadencia real de "cada
             cuánto se resincroniza todo el catálogo" la controla
             providers_sync_interval_hours / accounts_sync_interval_hours
             (freematica.config, default 24h) — no este intervalo. -->
        <record id="ir_cron_freematica_sync_providers" model="ir.cron">
            <field name="name">Freematica: Sincronizar proveedores</field>
            <field name="model_id" ref="model_freematica_config"/>
            <field name="state">code</field>
            <field name="code">model._cron_sync_providers()</field>
            <field name="interval_number" eval="10"/>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>

        <record id="ir_cron_freematica_sync_accounts" model="ir.cron">
            <field name="name">Freematica: Sincronizar plan de cuentas</field>
            <field name="model_id" ref="model_freematica_config"/>
            <field name="state">code</field>
            <field name="code">model._cron_sync_accounts()</field>
            <field name="interval_number" eval="10"/>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>

        <!-- Empareja con Freematica los proveedores de las facturas pendientes
             de enviar, para avisar en Finia antes de enviar (ver
             finia.ocr.vendor._freematica_match_pending). -->
        <record id="ir_cron_freematica_match_vendors" model="ir.cron">
            <field name="name">Freematica: emparejar proveedores pendientes</field>
            <field name="model_id" ref="finIA_backend.model_finia_ocr_vendor"/>
            <field name="state">code</field>
            <field name="code">model._cron_freematica_match_pending()</field>
            <field name="interval_number" eval="15"/>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>
        <!-- Envía a Freematica los albaranes de compra en Excel (si está activo en
             la configuración). Cada corrida tiene un presupuesto de tiempo. -->
        <record id="ir_cron_freematica_send_albaranes" model="ir.cron">
            <field name="name">Freematica: enviar albaranes de compra</field>
            <field name="model_id" ref="finIA_backend.model_finia_albaran"/>
            <field name="state">code</field>
            <field name="code">model._cron_freematica_send_albaranes()</field>
            <field name="interval_number" eval="15"/>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>

        <record id="ir_cron_freematica_sync_articles" model="ir.cron">
            <field name="name">Freematica: sincronizar artículos</field>
            <field name="model_id" ref="model_freematica_config"/>
            <field name="state">code</field>
            <field name="code">model._cron_sync_articles()</field>
            <field name="interval_number" eval="6"/>
            <field name="interval_type">hours</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
