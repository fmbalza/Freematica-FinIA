<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="freematica_article_view_list" model="ir.ui.view">
        <field name="name">freematica.article.view.list</field>
        <field name="model">freematica.article</field>
        <field name="arch" type="xml">
            <list create="false">
                <field name="cod_articulo"/>
                <field name="descripcion"/>
                <field name="cod_proveedor"/>
                <field name="cod_iva"/>
                <field name="cod_familia" optional="show"/>
                <field name="last_synced_at" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="freematica_article_view_search" model="ir.ui.view">
        <field name="name">freematica.article.view.search</field>
        <field name="model">freematica.article</field>
        <field name="arch" type="xml">
            <search>
                <field name="cod_articulo"/>
                <field name="descripcion"/>
                <field name="cod_proveedor"/>
            </search>
        </field>
    </record>

    <record id="freematica_article_action" model="ir.actions.act_window">
        <field name="name">Artículos Freematica</field>
        <field name="res_model">freematica.article</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
