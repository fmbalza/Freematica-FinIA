<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="freematica_provider_view_tree" model="ir.ui.view">
        <field name="name">freematica.provider.view.tree</field>
        <field name="model">freematica.provider</field>
        <field name="arch" type="xml">
            <list>
                <field name="cod_pro"/>
                <field name="nombre_pro"/>
                <field name="nif"/>
                <field name="cta_contable"/>
                <field name="poblacion"/>
                <field name="last_synced_at"/>
            </list>
        </field>
    </record>

    <record id="freematica_provider_view_form" model="ir.ui.view">
        <field name="name">freematica.provider.view.form</field>
        <field name="model">freematica.provider</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="cod_pro" readonly="1"/>
                            <field name="nombre_pro" readonly="1"/>
                            <field name="nif" readonly="1"/>
                            <field name="referencia" readonly="1"/>
                        </group>
                        <group>
                            <field name="cta_contable" readonly="1"/>
                            <field name="poblacion" readonly="1"/>
                            <field name="email" readonly="1"/>
                            <field name="telefono" readonly="1"/>
                            <field name="last_synced_at" readonly="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="freematica_provider_view_search" model="ir.ui.view">
        <field name="name">freematica.provider.view.search</field>
        <field name="model">freematica.provider</field>
        <field name="arch" type="xml">
            <search>
                <field name="cod_pro"/>
                <field name="nombre_pro"/>
                <field name="nif"/>
            </search>
        </field>
    </record>

    <record id="freematica_provider_action" model="ir.actions.act_window">
        <field name="name">Proveedores Freematica</field>
        <field name="res_model">freematica.provider</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
