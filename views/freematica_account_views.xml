<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="freematica_account_view_tree" model="ir.ui.view">
        <field name="name">freematica.account.view.tree</field>
        <field name="model">freematica.account</field>
        <field name="arch" type="xml">
            <list>
                <field name="cod_plan"/>
                <field name="cod_cta"/>
                <field name="des_cta"/>
                <field name="des_cta2"/>
                <field name="cta_activa" widget="boolean_toggle"/>
                <field name="subcuenta" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="freematica_account_view_search" model="ir.ui.view">
        <field name="name">freematica.account.view.search</field>
        <field name="model">freematica.account</field>
        <field name="arch" type="xml">
            <search>
                <field name="cod_cta"/>
                <field name="des_cta"/>
                <filter string="Activas" name="activas" domain="[('cta_activa', '=', True)]"/>
                <filter string="Imputables" name="imputables" domain="[('subcuenta', '=', True)]"/>
            </search>
        </field>
    </record>

    <record id="freematica_account_action" model="ir.actions.act_window">
        <field name="name">Plan de Cuentas Freematica</field>
        <field name="res_model">freematica.account</field>
        <field name="view_mode">list</field>
        <field name="context">{'search_default_activas': 1, 'search_default_imputables': 1}</field>
    </record>
</odoo>
